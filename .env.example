# Email del form contatti (Resend)
RESEND_API_KEY=
RESEND_FROM=
CONTACT_RECIPIENT=
NUXT_PUBLIC_SITE_URL=https://didap.it

# Postgres per le modifiche fatte da /admin (Coolify: shared-postgres nel
# progetto shared-infra, database "didap", creato da solo al primo avvio).
# L'app deve avere "Connect to Predefined Network" attivo.
DATABASE_URL=postgres://postgres:PASSWORD@gv736q23olxfeu9dwbv6qeuj:5432/didap

# Prima persona di /admin, creata al primo avvio se non c'è nessuno.
# Poi le persone si gestiscono dalla pagina Collaboratori.
ADMIN_EMAIL=
# Solo password iniziale della prima persona (almeno 10 caratteri)
ADMIN_PASSWORD=
# Chiave che sigilla il cookie di sessione: almeno 32 caratteri casuali
# (es. openssl rand -hex 24). Senza, /admin non è configurato.
SESSION_SECRET=
# Recupero: con "true" all'avvio riattiva ADMIN_EMAIL con ADMIN_PASSWORD e
# tutte le pagine. Toglila subito dopo.
# ADMIN_RESET=true

# Test di integrazione (npm test): database separato, deve finire con _test
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5435/didap_test

# Radar bandi: Claude legge i bandi. Senza chiave il radar non scarica e non legge nulla.
ANTHROPIC_API_KEY=
RADAR_LLM_MODEL=claude-haiku-5-5
# Caratteri massimi per bando mandati al modello
RADAR_LLM_MAX_CHARS=60000

# Radar bandi: cartella dei file di ogni bando, salvata su Cloudinary.
# Dal pannello Cloudinary (Settings > API Keys). I file sono privati (tipo "authenticated").
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
